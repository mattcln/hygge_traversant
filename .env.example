# Copier en .env et remplir. Ne jamais committer le .env.

# Noms de canaux ntfy : longs et impossibles à deviner (ntfy.sh est public,
# quiconque connaît le nom du canal peut le lire). Par exemple :
#   python3 -c "import secrets; print('hygge-' + secrets.token_urlsafe(12))"
NTFY_TOPIC_ALERTS=hygge-a-remplacer-alertes
NTFY_TOPIC_QUIET=hygge-a-remplacer-silencieux
NTFY_TOPIC_TEST=hygge-a-remplacer-test

# Serveur ntfy (garder ntfy.sh pour démarrer)
NTFY_SERVER=https://ntfy.sh

# Signature du message de présentation
CONTACT_PHONE=+45 12 34 56 78

# Plus tard, pour l'analyse par LLM (laisser vide pour l'instant)
ANTHROPIC_API_KEY=
